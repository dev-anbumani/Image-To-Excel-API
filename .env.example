# Copy to .env and adjust. Never commit the real .env.

# --- Django ---
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
CORS_ALLOWED_ORIGINS=http://localhost:4300,http://127.0.0.1:4300
LOG_LEVEL=INFO

# --- Database (sqlite by default; set DB_ENGINE=mysql to use MySQL) ---
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Upload limits ---
CONVERTER_MAX_FILES=10
CONVERTER_MAX_FILE_SIZE_MB=10
CONVERTER_MIN_IMAGE_SIDE=64
CONVERTER_MAX_IMAGE_SIDE=10000
CONVERTER_MAX_IMAGE_PIXELS=40000000

# --- Processing ---
CONVERTER_PROCESSING_MAX_SIDE=2400
CONVERTER_WORKER_THREADS=1
CONVERTER_MAX_QUEUED_JOBS=50
CONVERTER_LOW_CONFIDENCE=0.80

# --- OCR engine ---
CONVERTER_OCR_ENGINE=paddle
# "en" uses the English recogniser; any other value uses the multilingual PP-OCRv5 recogniser.
CONVERTER_OCR_LANG=en
# mobile (fast, ~1.8 GB RAM) or server (more accurate, slower, more RAM)
CONVERTER_OCR_MODEL_PROFILE=mobile
CONVERTER_OCR_CPU_THREADS=4
CONVERTER_PRELOAD_OCR=true

# --- Temporary storage ---
CONVERTER_STORAGE_DIR=
CONVERTER_RETENTION_MINUTES=60
CONVERTER_CLEANUP_INTERVAL_MINUTES=10

# --- Rate limits (per client IP) ---
THROTTLE_CONVERT=20/min
THROTTLE_EXPORT=60/min
THROTTLE_STATUS=600/min

# Skip PaddleX's slow connectivity check at startup
DISABLE_MODEL_SOURCE_CHECK=True
